Name=Kernel-5
Type=Kernel
Target=uefi-x64
Toolchain=clang
Architecture=x86_64
Entry=KernelStart

[KernelLayout]
KernelPhysicalBase=0x4000000
KernelVirtualBase=0xFFFFFFFF80000000

[BootConfiguration]
CommandLine=oryn.boot=normal oryn.log=serial

[Source]
Source/**/*.c

[Include]
Include

[Run]
VM=QEMU
Memory=512M
Serial=stdio
Display=none
