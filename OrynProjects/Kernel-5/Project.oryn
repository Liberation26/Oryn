Name=Kernel-5
Type=Kernel
Target=uefi-x64
Toolchain=clang
Architecture=x86_64
Entry=KernelStart

[KernelLayout]
KernelPhysicalBase=0x4000000
KernelVirtualBase=0xFFFFFFFF80000000

[BootConfiguration]
CommandLine=oryn.boot=normal oryn.log=serial

[Source]
Source/**/*.c

[Include]
Include

[Run]
VM=QEMU
FormatVM=yes
DiskFormat=raw
StorageInterface=ide
Memory=2G
CPU=max
SMP=8
PIC=on
APIC=on
APIC2=on
HPET=on
Serial=stdio
Display=sdl
